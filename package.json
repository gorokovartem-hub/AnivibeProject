{
  "name": "animevibe",
  "version": "2.0.0",
  "description": "Каталог манги с авто-конвертацией в WebP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "convert": "node auto-convert.js",
    "dev": "concurrently \"node server.js\" \"node auto-convert.js\"",
    "dev:names": "concurrently --names \"SERVER,CONVERT\" \"node server.js\" \"node auto-convert.js\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^2.6.7",
    "sharp": "^0.32.0",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "concurrently": "^8.0.0"
  }
}